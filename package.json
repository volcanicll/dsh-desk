{
  "name": "dsh-desk",
  "productName": "DSH Desk",
  "version": "0.1.0",
  "description": "Desktop wrapper for DeepSeek Harness (dsh). Preserves the original web UI and interactions while adding native desktop behavior.",
  "type": "module",
  "main": "src/main/index.js",
  "author": "volcanicll <1605090219@qq.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "fetch:node": "node scripts/fetch-node.mjs",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "prepare:runtime": "npm run fetch:node && npm run bundle:dsh",
    "pack": "npm run prepare:runtime && electron-builder --dir",
    "dist": "npm run prepare:runtime && electron-builder",
    "dist:mac": "npm run prepare:runtime && electron-builder --mac",
    "dist:win": "npm run prepare:runtime && electron-builder --win",
    "dist:linux": "npm run prepare:runtime && electron-builder --linux",
    "smoke": "node scripts/smoke.mjs",
    "check:update": "node scripts/check-dsh-update.mjs",
    "update:dsh": "node scripts/check-dsh-update.mjs --apply"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcanicll/dsh-desk.git"
  },
  "bugs": {
    "url": "https://github.com/volcanicll/dsh-desk/issues"
  },
  "homepage": "https://github.com/volcanicll/dsh-desk",
  "keywords": [
    "electron",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "desktop",
    "agent",
    "ai"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "version": "0.1.0-rc.7"
  }
}
